<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/Report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="sans-serif-thin"
            android:gravity="center"
            android:text="@string/report_issue_title"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:id="@+id/CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageButton
                    android:id="@+id/backArrow"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="left"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/back_desc"
                    android:layoutDirection="ltr"
                    app:srcCompat="@drawable/baseline_arrow_back_24" />

                <Spinner
                    android:id="@+id/spinner_governorates"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"

                    android:layout_marginTop="20dp" />

                <Spinner
                    android:id="@+id/spAuthority"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp" />

                <Spinner
                    android:id="@+id/sptype"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp" />


                <EditText
                    android:id="@+id/editTextDate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/edit_box"
                    android:hint="@string/select_date_hint"
                    android:inputType="date" />

                <TextView
                    android:id="@+id/Topic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/write_title_label"
                    android:textColor="#051422"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/Title_txt"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_box"
                    android:hint="@string/title_hint"
                    android:inputType="text" />

                <TextView
                    android:id="@+id/descLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/desc_label"
                    android:textColor="#051422"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/DisTxt"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/edit_box"
                    android:hint="@string/desc_hint"
                    android:inputType="textMultiLine"
                    android:gravity="start|top" />

                <TextView
                    android:id="@+id/LocationLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/location_label"
                    android:textColor="#051422"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <com.google.android.gms.maps.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:contentDescription="@string/map_desc"
                    android:focusable="true" />

                <ImageButton
                    android:id="@+id/camera"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/camera_desc"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_camera" />

                <Button
                    android:id="@+id/submit_report"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#D6D6D6"
                    android:text="@string/submit_button"
                    android:textColor="#051422"
                    android:textSize="20sp"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
