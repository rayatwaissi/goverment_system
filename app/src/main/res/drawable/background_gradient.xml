<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!--
    <gradient>: Defines a color transition (gradient) that fills the shape.
    android:angle="270" → Direction of the gradient:top to bottom
    android:startColor="#299E9B" → The color at the top
        android:endColor="#027F8C" → The color at the bottom
        android:type="linear" → A straight-line gradient
     -->
    <gradient
        android:angle="270"
        android:startColor="#299E9B"
        android:endColor="#027F8C"
        android:type="linear"/>
</shape>